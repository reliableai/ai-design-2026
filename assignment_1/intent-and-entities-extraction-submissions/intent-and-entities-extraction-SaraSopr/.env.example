# Hugging Face dataset identifier (optional)
# Example: bitext/Bitext-customer-support-llm-chatbot-training-dataset
HF_DATASET_ID=bitext/Bitext-customer-support-llm-chatbot-training-dataset
HF_DATASET_SPLIT=train

# Optional local dataset path (csv/json/jsonl/parquet)
# If set, notebook/script will use this file first.
LOCAL_DATASET_PATH=

# OpenAI settings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
